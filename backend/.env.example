# Copy to .env (start_backend.sh does this automatically and generates a key).
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./parakh.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model parameters (paper Section III). Defaults shown.
TEST_LENGTH=20
SLOPE_A=4.0
STEP_ETA=0.15
DELTA=0.20
BAND_W=0.15
